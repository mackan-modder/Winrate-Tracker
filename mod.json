{
	"geode": "5.6.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "mackan.winrate-tracker",
	"name": "Winrate Tracker",
	"version": "v1.0.0",
	"developer": "Mackan",
	"description": "Accurate winrate tracking",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"cvolton.level-id-api": ">=2.0.0"
	},"settings": {
		"label-opacity": {
            "name": "Label Opacity",
            "description": "Changes the opacity of the labels",
            "type": "float",
            "default": 0.4,
            "min": 0,
            "max": 1,
            "control": {
                "slider": true
            }
        },
        "completion-time": {
            "name": "Enable Estimated Completion Time",
            "type": "bool",
            "default": true
        },
        "winrate-flat": {
            "name": "Enable Winrate",
            "type": "bool",
            "default": true
        },
        "winrate-dynamic": {
            "name": "Enable Dynamic Winrate",
            "type": "bool",
            "default": true
        }
	}
}
