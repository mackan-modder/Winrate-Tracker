{
	"geode": "5.6.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "mackan.winrate-tracker",
	"name": "Winrate Tracker",
	"version": "v1.0.0",
	"developer": "Mackan",
	"description": "Accurate winrate tracking",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"cvolton.level-id-api": ">=2.0.0"
	},"settings": {
		"label-opacity": {
            "name": "Label Opacity",
            "description": "Changes the opacity of the labels",
            "type": "float",
            "default": 0.4,
            "min": 0,
            "max": 1,
            "control": {
                "slider": true
            }
        },
        "completion-time": {
            "name": "Enable Estimated Completion Time",
            "type": "bool",
            "default": true
        },
        "winrate-flat": {
            "name": "Enable Winrate",
            "type": "bool",
            "default": true
        },
        "winrate-dynamic": {
            "name": "Enable Dynamic Winrate",
            "type": "bool",
            "default": true
        },
        "rarity-label": {
            "name": "Enable Run Rarity Label",
            "type": "bool",
            "default": true
        },
        "settings-alpha": {
            "name": "Alpha value",
            "description": "Alpha determines how fast your winrate changes. A lower alpha results in a slower but more stable rate. A higher Alpha results in faster changes but is less stable. I would not recommend going much higher than the default 0.15 but you could potentially decrease it if you are playing levels longterm.",
            "type": "float",
            "default": 0.15,
            "min": 0.001,
            "max": 0.5,
            "control": {
                "slider": true
            }
        },
        "time-format": {
            "name": "Use Days and Years",
            "type": "bool",
            "default": false
        }
	},"resources": {
        "sprites": [
            "resources/percentage.png"
        ]
    }}
